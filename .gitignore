# Python virtual environment
/.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type-checker and linter caches
.mypy_cache/
.ruff_cache/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Python build artifacts
build/
dist/
*.egg-info/

# IDE settings
/.vscode/
/.idea/

# Operating-system files
.DS_Store
Thumbs.db

# Local telemetry binaries and runtime data
/telemetry-tools/